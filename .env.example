# Ports (loopback only). Change these if the defaults are taken; DATABASE_URL and
# REDIS_URL are derived from them by scripts/dev.sh unless you set those explicitly.
CALLMAP_WEB_PORT=5175
CALLMAP_API_PORT=8012
CALLMAP_PG_PORT=55434
CALLMAP_REDIS_PORT=6382
# Docker Compose project name; change it to run a second, independent copy.
COMPOSE_PROJECT_NAME=callmap
# DATABASE_URL=postgresql://callmap:callmap_local_only@127.0.0.1:55434/callmap
# REDIS_URL=redis://127.0.0.1:6382/0
CALLMAP_DATA_DIR=.data/audio
# Optional local-only auth: default is generated into .data/local-token (mode 0600).
# CALLMAP_LOCAL_TOKEN=replace-with-a-long-random-value
# Default: fixture (never sends externally). Live mode requires explicit per-upload opt-in.
CALLMAP_PROVIDER=fixture
CALLMAP_GEMINI_MODEL=gemini-3.5-flash-lite
# GEMINI_API_KEY=your-key-from-a-billing-disabled-project
# Never commit a real key. Prefer exporting GEMINI_API_KEY in the shell that runs scripts/dev.sh.
